# Normalize text files to LF in the repo, checkout as native
* text=auto

# Force LF for scripts and config (run on Linux CI)
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Binary — never touch
*.mp3 binary
*.wav binary
*.ogg binary
