{
	"$schema": "./moods.schema.json",
	"_comment": "Mood presets for prosody control. Applied to sections of entries based on content.",

	"presets": {
		"cozy": {
			"rate": "-5%",
			"pitch": "0%",
			"volume": "medium",
			"description": "Slightly slower, warm. Default storytelling pace."
		},
		"tense": {
			"rate": "0%",
			"pitch": "0%",
			"volume": "medium",
			"description": "Normal pace, content carries the tension."
		},
		"urgent": {
			"rate": "+3%",
			"pitch": "0%",
			"volume": "medium",
			"description": "Slightly faster. Let the words create urgency."
		},
		"triumphant": {
			"rate": "0%",
			"pitch": "0%",
			"volume": "medium",
			"description": "Normal. The words do the work."
		},
		"reflective": {
			"rate": "-5%",
			"pitch": "0%",
			"volume": "medium",
			"description": "Slightly slower. Thoughtful."
		},
		"matter-of-fact": {
			"rate": "0%",
			"pitch": "0%",
			"volume": "medium",
			"description": "Neutral. Default pace."
		},
		"dramatic": {
			"rate": "-3%",
			"pitch": "0%",
			"volume": "medium",
			"description": "Slightly slower for weight."
		},
		"weary": {
			"rate": "-5%",
			"pitch": "-2%",
			"volume": "soft",
			"description": "Tired. Soft and slightly slower."
		}
	},

	"section_hints": {
		"_comment": "Hints for the SSML generator to auto-assign moods based on heading text or content patterns.",
		"headings": {
			"Why This Journal Exists": "cozy",
			"The Short Version": "matter-of-fact",
			"What We Learned": "reflective",
			"Agent Performance": "matter-of-fact",
			"The Score": "triumphant",
			"Commits": "matter-of-fact"
		},
		"patterns": {
			"Then we found": "tense",
			"It worked": "triumphant",
			"But wait": "dramatic",
			"Frontend changes had never been deploying": "tense",
			"Let that sink in": "dramatic",
			"Not bad for a night shift": "triumphant",
			"Keep building": "cozy"
		}
	}
}
